{
  "name": "miku-home",
  "version": "0.1.0",
  "description": "Accessible, local-first, open-source voice assistant (PWA).",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server/server.js",
    "csp": "node scripts/csp.mjs",
    "test:html": "html-validate app/index.html app/privacy.html",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:pa11y": "node tests/pa11y.mjs",
    "test": "npm run test:html && npm run test:unit && npm run test:e2e && npm run test:pa11y"
  },
  "author": "BowieMoonen",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "axe-core": "^4.14.0",
    "home-assistant-js-websocket": "^9.7.1",
    "three": "^0.186.1",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "html-validate": "^10.17.0",
    "pa11y": "^9.1.1",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^24.43.1"
  },
  "private": true
}
